<?xml version="1.0" encoding="utf-8"?>
<!-- A voice input method. The "voice" subtype lets keyboards with a voice-input shortcut switch straight to it. -->
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsActivity="app.thumbfree.SetupActivity"
    android:supportsSwitchingToNextInputMethod="true">
    <subtype
        android:imeSubtypeLocale="en_IN"
        android:imeSubtypeMode="voice"
        android:label="@string/subtype_voice" />
</input-method>
